---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminHeader from '../../components/AdminHeader.astro';
import { listContests, getContestStats } from '../../lib/db';

const db = env.DB;
const contests = await listContests(db);
const statsList = await Promise.all(contests.map((c) => getContestStats(db, c.id)));
---

<BaseLayout title="대회 관리 · 모음터">
  <AdminHeader />

  <main class="mx-auto max-w-6xl px-5 py-10">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-xl font-extrabold text-gray-900">공모전 목록</h1>
      <a href="/admin/new" class="btn-primary">+ 새 공모전 만들기</a>
    </div>

    {
      contests.length === 0 ? (
        <div class="card p-14 text-center text-gray-400">
          아직 만들어진 공모전이 없어요. 상단의 버튼으로 첫 공모전을 만들어보세요.
        </div>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {contests.map((c, i) => (
            <div class="card p-6">
              <div class="flex items-start justify-between">
                <h2 class="text-base font-bold text-gray-900">{c.name}</h2>
                <span class="badge" style={c.is_active ? 'background:#dcfce7;color:#166534' : 'background:#f1f5f9;color:#64748b'}>
                  {c.is_active ? '진행중' : '비활성'}
                </span>
              </div>
              <p class="mt-1 text-xs text-gray-400">/{c.slug}</p>
              <p class="mt-3 text-2xl font-extrabold text-gray-900">
                {statsList[i].total}
                <span class="ml-1 text-sm font-medium text-gray-400">건 접수</span>
              </p>
              <div class="mt-5 flex gap-2">
                <a href={`/admin/${c.slug}`} class="btn-primary flex-1 !px-3 !py-2 text-sm">제출 관리</a>
                <a href={`/admin/${c.slug}/edit`} class="btn-secondary flex-1 !px-3 !py-2 text-sm">설정</a>
              </div>
              <a href={`/c/${c.slug}`} target="_blank" class="mt-2 block text-center text-xs text-gray-400 hover:text-gray-600">
                공개 페이지 보기 ↗
              </a>
            </div>
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>
