---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminHeader from '../../../components/AdminHeader.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { getContestBySlug, getSubmission, updateSubmissionStatus, setSubmissionStatus, DELETED_STATUS } from '../../../lib/db';
import { formatFileSize } from '../../../lib/storage';

const { slug, id } = Astro.params;
const db = env.DB;
const contest = slug ? await getContestBySlug(db, slug) : null;
let submission = id ? await getSubmission(db, id) : null;

if (!contest || !submission || submission.contest_id !== contest.id) {
  return new Response(null, { status: 404 });
}

const STATUS_OPTIONS = ['접수', '검토중', '통과', '보류', '반려'];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? 'update_status');

  // 실제로 지우지 않고 "삭제함" 상태로 옮김 — 파일/기록은 그대로 남아서 복구 가능
  if (action === 'delete') {
    await setSubmissionStatus(db, submission.id, DELETED_STATUS);
    return Astro.redirect(`/admin/${contest.slug}?deleted=1`, 303);
  }

  if (action === 'restore') {
    await setSubmissionStatus(db, submission.id, '접수');
    return Astro.redirect(`/admin/${contest.slug}/${submission.id}?restored=1`, 303);
  }

  const status = String(form.get('status') ?? submission.status);
  const adminNote = String(form.get('admin_note') ?? '');
  await updateSubmissionStatus(db, submission.id, status, adminNote);
  return Astro.redirect(`/admin/${contest.slug}/${submission.id}?saved=1`, 303);
}

const saved = Astro.url.searchParams.get('saved') === '1';
const restored = Astro.url.searchParams.get('restored') === '1';
const isDeleted = submission.status === DELETED_STATUS;
const submittedAt = new Date(submission.created_at).toLocaleString('ko-KR');
---

<BaseLayout title={`${submission.title} · ${contest.name}`}>
  <AdminHeader title={contest.name} />

  <main class="mx-auto max-w-3xl px-5 py-10">
    <a href={`/admin/${contest.slug}`} class="text-sm font-medium text-gray-400 hover:text-gray-600">← 목록으로</a>

    <div class="mt-3 mb-6 flex items-center justify-between">
      <div>
        <p class="font-mono text-xs text-gray-400">{submission.id}</p>
        <h1 class="mt-1 text-xl font-extrabold text-gray-900">{submission.title}</h1>
      </div>
      <StatusBadge status={submission.status} />
    </div>

    {saved && <div class="mb-4 rounded-lg bg-green-50 px-4 py-3 text-sm font-medium text-green-700">저장되었어요.</div>}
    {restored && <div class="mb-4 rounded-lg bg-green-50 px-4 py-3 text-sm font-medium text-green-700">복구됐어요.</div>}
    {isDeleted && <div class="mb-4 rounded-lg bg-gray-800 px-4 py-3 text-sm font-medium text-white">삭제함으로 분류된 제출물이에요. 아래 "복구하기" 버튼으로 되돌릴 수 있어요.</div>}

    <div class="card mb-6 space-y-4 p-6">
      <h2 class="text-sm font-bold text-gray-400">작품 정보</h2>
      <dl class="grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs text-gray-400">공모 분야</dt>
          <dd class="font-medium text-gray-800">{submission.category || '-'}</dd>
        </div>
        <div>
          <dt class="text-xs text-gray-400">공모 주제</dt>
          <dd class="font-medium text-gray-800">{submission.topic || '-'}{submission.free_topic_text && ` (${submission.free_topic_text})`}</dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-xs text-gray-400">작품 설명</dt>
          <dd class="whitespace-pre-line font-medium text-gray-800">{submission.description || '-'}</dd>
        </div>
        <div>
          <dt class="text-xs text-gray-400">작품</dt>
          <dd class="font-medium text-gray-800">
            {
              submission.work_file_key ? (
                <a href={`/admin/files/${submission.work_file_key}`} class="text-brand-600 underline" style="color:#4f46e5">
                  ⬇ {submission.work_file_name || '파일 다운로드'} ({formatFileSize(submission.work_file_size)})
                </a>
              ) : submission.work_link ? (
                <a href={submission.work_link} target="_blank" class="text-brand-600 underline" style="color:#4f46e5">{submission.work_link}</a>
              ) : (
                '-'
              )
            }
          </dd>
        </div>
        <div>
          <dt class="text-xs text-gray-400">발표 자료</dt>
          <dd class="font-medium text-gray-800">
            {
              submission.slide_file_key ? (
                <a href={`/admin/files/${submission.slide_file_key}`} class="text-brand-600 underline" style="color:#4f46e5">
                  ⬇ {submission.slide_file_name || '파일 다운로드'} ({formatFileSize(submission.slide_file_size)})
                </a>
              ) : submission.slide_link ? (
                <a href={submission.slide_link} target="_blank" class="text-brand-600 underline" style="color:#4f46e5">{submission.slide_link}</a>
              ) : (
                '-'
              )
            }
          </dd>
        </div>
        <div>
          <dt class="text-xs text-gray-400">사용한 AI 도구</dt>
          <dd class="font-medium text-gray-800">{submission.ai_tools || '-'}</dd>
        </div>
        <div>
          <dt class="text-xs text-gray-400">제출 시각</dt>
          <dd class="font-medium text-gray-800">{submittedAt}</dd>
        </div>
      </dl>
    </div>

    <div class="card mb-6 space-y-4 p-6">
      <h2 class="text-sm font-bold text-gray-400">참가자 정보</h2>
      <p class="text-sm text-gray-500">
        참가 형태: <span class="font-semibold text-gray-800">{submission.participation_type === 'team' ? `모둠 (${submission.team_name})` : '개인'}</span>
      </p>
      <ul class="divide-y divide-black/5">
        {
          submission.participants.map((p, i) => (
            <li class="flex items-center justify-between py-2 text-sm">
              <span class="text-gray-400">참가 학생{i + 1}</span>
              <span class="font-semibold text-gray-800">{p.raw}</span>
            </li>
          ))
        }
      </ul>
      <div class="flex gap-4 border-t border-black/5 pt-4 text-xs text-gray-400">
        <span>개인정보 동의: {submission.privacy_consent ? '✅' : '❌'}</span>
        <span>전시 동의: {submission.exhibit_consent ? '✅' : '❌'}</span>
        <span>참가 서약: {submission.pledge_consent ? '✅' : '❌'}</span>
      </div>
    </div>

    <form method="POST" class="card space-y-4 p-6">
      <h2 class="text-sm font-bold text-gray-400">심사 상태</h2>
      <div>
        <label class="field-label" for="status">상태</label>
        <select id="status" name="status" class="input-field">
          {STATUS_OPTIONS.map((s) => (
            <option value={s} selected={submission.status === s}>{s}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="field-label" for="admin_note">관리자 메모 (학생에게는 보이지 않아요)</label>
        <textarea id="admin_note" name="admin_note" rows="3" class="input-field">{submission.admin_note}</textarea>
      </div>
      <button type="submit" class="btn-primary w-full">저장하기</button>
    </form>

    {
      isDeleted ? (
        <form method="POST" class="mt-4">
          <input type="hidden" name="_action" value="restore" />
          <button type="submit" class="w-full rounded-lg border border-green-200 bg-green-50 px-4 py-2.5 text-sm font-semibold text-green-700 hover:bg-green-100">
            이 제출물 복구하기
          </button>
        </form>
      ) : (
        <form
          method="POST"
          class="mt-4"
          onsubmit="return confirm('이 제출물을 삭제함으로 옮길까요? 파일은 지워지지 않고, 목록에서 \'삭제함\'으로 들어가면 다시 복구할 수 있어요.');"
        >
          <input type="hidden" name="_action" value="delete" />
          <button type="submit" class="w-full rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-100">
            이 제출물 삭제하기
          </button>
        </form>
      )
    }
  </main>
</BaseLayout>
