---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminHeader from '../../../components/AdminHeader.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { getContestBySlug, listSubmissions, getContestStats, DELETED_STATUS } from '../../../lib/db';

const { slug } = Astro.params;
const db = env.DB;
const contest = slug ? await getContestBySlug(db, slug) : null;

if (!contest) {
  return new Response(null, { status: 404 });
}

const params = Astro.url.searchParams;
const search = params.get('q') ?? '';
const status = params.get('status') ?? '';
const category = params.get('category') ?? '';
const sort = (params.get('sort') as 'created_at' | 'title' | 'status') ?? 'created_at';
const order = (params.get('order') as 'asc' | 'desc') ?? 'desc';

const submissions = await listSubmissions(db, {
  contestId: contest.id,
  search: search || undefined,
  status: status || undefined,
  excludeStatus: status ? undefined : DELETED_STATUS,
  category: category || undefined,
  sort,
  order,
});

const stats = await getContestStats(db, contest.id);
const STATUS_OPTIONS = ['접수', '검토중', '통과', '보류', '반려'];
const activeTotal = stats.byStatus
  .filter((b) => b.status !== DELETED_STATUS)
  .reduce((sum, b) => sum + b.count, 0);
const deletedCount = stats.byStatus.find((b) => b.status === DELETED_STATUS)?.count ?? 0;
const viewingDeleted = status === DELETED_STATUS;

function qs(overrides: Record<string, string>) {
  const next = new URLSearchParams(params);
  Object.entries(overrides).forEach(([k, v]) => {
    if (v) next.set(k, v);
    else next.delete(k);
  });
  return `?${next.toString()}`;
}

const deleted = params.get('deleted') === '1';
const restored = params.get('restored') === '1';
const currentQs = Astro.url.search;
---

<BaseLayout title={`${contest.name} 제출 관리 · 함께 만드는 안전 디지털 세상`}>
  <AdminHeader title={contest.name} />

  <main class="mx-auto max-w-6xl px-5 py-10">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <div>
        <a href="/admin" class="text-sm font-medium text-gray-400 hover:text-gray-600">← 목록으로</a>
        <h1 class="mt-1 text-xl font-extrabold text-gray-900">{contest.name}</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href={`/admin/${contest.slug}/export.xlsx`} class="btn-secondary text-sm">엑셀 다운로드 (명단·통과/검토중)</a>
        <a href={`/admin/${contest.slug}/download-files.zip${Astro.url.search}`} class="btn-secondary text-sm">
          {viewingDeleted ? '삭제함' : status || '전체'} 작품 파일 전체 다운로드 (zip)
        </a>
        <a href={`/admin/${contest.slug}/export.csv${Astro.url.search}`} class="btn-secondary text-sm">CSV 내보내기</a>
        <a href={`/c/${contest.slug}`} target="_blank" class="btn-secondary text-sm">공개 페이지 ↗</a>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap gap-2">
      <a href={qs({ status: '' })} class="badge" style={!status ? 'background:#4338ca;color:white' : 'background:#f1f5f9;color:#475569'}>
        전체 {activeTotal}
      </a>
      {
        STATUS_OPTIONS.map((s) => {
          const count = stats.byStatus.find((b) => b.status === s)?.count ?? 0;
          return (
            <a href={qs({ status: s })} class="badge" style={status === s ? 'background:#4338ca;color:white' : 'background:#f1f5f9;color:#475569'}>
              {s} {count}
            </a>
          );
        })
      }
      <a href={qs({ status: DELETED_STATUS })} class="badge" style={viewingDeleted ? 'background:#1f2937;color:white' : 'background:#f1f5f9;color:#475569'}>
        삭제함 {deletedCount}
      </a>
    </div>

    <form method="GET" class="card mb-6 flex flex-wrap items-end gap-3 p-4">
      <div class="min-w-[200px] flex-1">
        <label class="field-label" for="q">검색</label>
        <input id="q" name="q" class="input-field" placeholder="작품명, 모둠명, 학생명, 접수번호" value={search} />
      </div>
      <div>
        <label class="field-label" for="category">분야</label>
        <select id="category" name="category" class="input-field">
          <option value="">전체</option>
          {contest.categories.map((c: string) => (
            <option value={c} selected={category === c}>{c}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="field-label" for="sort">정렬</label>
        <select id="sort" name="sort" class="input-field">
          <option value="created_at" selected={sort === 'created_at'}>제출일</option>
          <option value="title" selected={sort === 'title'}>작품명</option>
          <option value="status" selected={sort === 'status'}>상태</option>
        </select>
      </div>
      <div>
        <label class="field-label" for="order">순서</label>
        <select id="order" name="order" class="input-field">
          <option value="desc" selected={order === 'desc'}>내림차순</option>
          <option value="asc" selected={order === 'asc'}>오름차순</option>
        </select>
      </div>
      <input type="hidden" name="status" value={status} />
      <button type="submit" class="btn-primary">검색</button>
    </form>

    {deleted && <div class="mb-4 rounded-lg bg-green-50 px-4 py-3 text-sm font-medium text-green-700">선택한 제출물을 삭제함으로 옮겼어요. "삭제함" 탭에서 다시 복구할 수 있어요.</div>}
    {restored && <div class="mb-4 rounded-lg bg-green-50 px-4 py-3 text-sm font-medium text-green-700">선택한 제출물을 복구했어요.</div>}
    {viewingDeleted && <div class="mb-4 rounded-lg bg-gray-800 px-4 py-3 text-sm font-medium text-white">삭제함으로 분류된 제출물이에요. 공개 페이지·CSV에는 나오지 않고, 선택 복구로 되돌릴 수 있어요.</div>}

    <form
      id="bulk_delete_form"
      method="POST"
      action={`/admin/${contest.slug}/${viewingDeleted ? 'bulk-restore' : 'bulk-delete'}`}
      onsubmit={viewingDeleted
        ? "return confirm('선택한 제출물을 접수 상태로 복구할까요?');"
        : "return confirm('선택한 제출물을 삭제함으로 옮길까요? 파일은 지워지지 않고, \\'삭제함\\' 탭에서 다시 복구할 수 있어요.');"}
    >
      <input type="hidden" name="redirect_qs" value={currentQs} />

      <div class="mb-3 flex items-center justify-between">
        <label class="flex items-center gap-2 text-sm text-gray-500">
          <input type="checkbox" id="select_all" />
          전체 선택
        </label>
        {
          viewingDeleted ? (
            <button type="submit" id="bulk_delete_btn" class="btn-secondary text-sm text-green-700" disabled>선택 복구</button>
          ) : (
            <button type="submit" id="bulk_delete_btn" class="btn-secondary text-sm text-red-600" disabled>선택 삭제</button>
          )
        }
      </div>

      <div class="card overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-black/5 text-xs text-gray-400">
            <tr>
              <th class="px-4 py-3"></th>
              <th class="px-4 py-3">번호</th>
              <th class="px-4 py-3">접수번호</th>
              <th class="px-4 py-3">작품 제목</th>
              <th class="px-4 py-3">분야</th>
              <th class="px-4 py-3">참가자</th>
              <th class="px-4 py-3">제출일</th>
              <th class="px-4 py-3">상태</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            {
              submissions.length === 0 ? (
                <tr>
                  <td colspan="9" class="px-4 py-14 text-center text-gray-400">조건에 맞는 제출이 없어요.</td>
                </tr>
              ) : (
                submissions.map((s, i) => (
                  <Fragment>
                    <tr class={s.admin_note ? 'hover:bg-gray-50' : 'border-b border-black/5 last:border-0 hover:bg-gray-50'}>
                      <td class="px-4 py-3">
                        <input type="checkbox" name="ids" value={s.id} class="row-checkbox" />
                      </td>
                      <td class="px-4 py-3 text-gray-400">{i + 1}</td>
                      <td class="px-4 py-3 font-mono text-xs text-gray-500">{s.id}</td>
                      <td class="px-4 py-3 font-semibold text-gray-900">{s.title}</td>
                      <td class="px-4 py-3 text-gray-500">{s.category || '-'}</td>
                      <td class="px-4 py-3 text-gray-500">
                        {s.participation_type === 'team' ? `${s.team_name} (${s.participants.length}명)` : (s.participants[0]?.name ?? '-')}
                      </td>
                      <td class="px-4 py-3 text-gray-500">{new Date(s.created_at).toLocaleDateString('ko-KR')}</td>
                      <td class="px-4 py-3"><StatusBadge status={s.status} /></td>
                      <td class="px-4 py-3 text-right">
                        <a href={`/admin/${contest.slug}/${s.id}`} class="font-semibold text-brand-600" style="color:#4f46e5">상세보기</a>
                      </td>
                    </tr>
                    {
                      s.admin_note && (
                        <tr class="border-b-2 border-gray-200 last:border-0 bg-amber-50/60">
                          <td class="py-1.5" colspan="2"></td>
                          <td colspan="7" class="px-4 py-1.5 pl-6 text-xs text-amber-800">
                            <span class="font-semibold">↳ 메모:</span> <span class="whitespace-pre-line">{s.admin_note}</span>
                          </td>
                        </tr>
                      )
                    }
                  </Fragment>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </form>
  </main>

  <script>
    const selectAll = document.getElementById('select_all') as HTMLInputElement | null;
    const bulkBtn = document.getElementById('bulk_delete_btn') as HTMLButtonElement | null;
    const rowCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.row-checkbox'));

    function updateBulkButton() {
      const anyChecked = rowCheckboxes.some((c) => c.checked);
      if (bulkBtn) bulkBtn.disabled = !anyChecked;
    }

    selectAll?.addEventListener('change', () => {
      rowCheckboxes.forEach((c) => (c.checked = selectAll.checked));
      updateBulkButton();
    });

    rowCheckboxes.forEach((c) => c.addEventListener('change', updateBulkButton));
    updateBulkButton();
  </script>
</BaseLayout>
