---
interface Props {
  status: string;
}
const { status } = Astro.props;

const styles: Record<string, string> = {
  접수: 'background:#eef2ff;color:#4338ca',
  검토중: 'background:#fef3c7;color:#92400e',
  통과: 'background:#dcfce7;color:#166534',
  보류: 'background:#f1f5f9;color:#475569',
  반려: 'background:#fee2e2;color:#b91c1c',
};
const style = styles[status] ?? 'background:#f1f5f9;color:#475569';
---

<span class="badge" style={style}>{status}</span>
